<% layout("/layouts/boilerplate") %>

<% const isSearch = typeof searchQuery !== "undefined" && searchQuery; %>
<% const filter = typeof activeFilter !== "undefined" ? activeFilter : null; %>

<%- include("../includes/filters", { active: filter ? filter.slug : null }) %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-4 mb-4">
  <div>
    <% if (filter) { %>
      <h1 class="page-heading h3 mb-1">
        <i class="fa-solid fa-<%= filter.icon %> text-coral"></i> <%= filter.name %>
      </h1>
      <p class="listing-meta mb-0">
        <% if (filter.name === "Trending") { %>Top-rated stays ·
        <% } else if (filter.name === "New") { %>Latest stays ·
        <% } %>
        <%= allListings.length %> stay<%= allListings.length === 1 ? "" : "s" %> ·
        <a href="/listings" class="link-dark">Clear filter</a>
      </p>
    <% } else if (isSearch) { %>
      <h1 class="page-heading h3 mb-1">Results for “<%= searchQuery %>”</h1>
      <p class="listing-meta mb-0">
        <%= allListings.length %> stay<%= allListings.length === 1 ? "" : "s" %> found ·
        <a href="/listings" class="link-dark">Clear search</a>
      </p>
    <% } else { %>
      <h1 class="page-heading h3 mb-0">Explore stays</h1>
    <% } %>
  </div>
  <% if (currUser) { %>
    <a href="/listings/new" class="btn sf-btn-primary">
      <i class="fa-solid fa-plus"></i> List your property
    </a>
  <% } %>
</div>

<% if (!allListings.length) { %>
  <div class="empty-state">
    <i class="fa-solid fa-house-circle-xmark d-block"></i>
    <% if (filter) { %>
      <h2 class="h5 text-dark">No <%= filter.name %> stays yet</h2>
      <p>Nothing has been listed under this category. Got a place like this?</p>
      <a href="/listings/new" class="btn sf-btn-primary"><i class="fa-solid fa-plus"></i> List your property</a>
    <% } else if (isSearch) { %>
      <h2 class="h5 text-dark">No stays match “<%= searchQuery %>”</h2>
      <p>Try a different place, a shorter keyword, or a higher price.</p>
      <a href="/listings" class="btn sf-btn-ghost">See all stays</a>
    <% } else { %>
      <h2 class="h5 text-dark">No listings yet</h2>
      <p>Be the first to list a property.</p>
    <% } %>
  </div>
<% } %>

<div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
  <% for (const listing of allListings) { %>
    <div class="col">
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card listing-card">
          <img
            src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=800&q=60' %>"
            class="card-img-top"
            alt="<%= listing.title %>"
            style="height: 16rem"
            loading="lazy"
          />
          <div class="card-body">
            <p class="card-text mb-0">
              <b><%= listing.title %></b><br />
              <span class="listing-meta"><%= listing.location %>, <%= listing.country %></span><br />
              <% if (typeof listing.price === "number") { %>
                <span class="listing-price">&#8377; <%= listing.price.toLocaleString("en-IN") %></span>
                <span class="listing-meta">/ night</span>
              <% } else { %>
                <span class="listing-meta">Price not available</span>
              <% } %>
            </p>
          </div>
        </div>
      </a>
    </div>
  <% } %>
</div>

<script src="/js/filters.js"></script>
